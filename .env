# -----------------------------------------------------------------------------
# 2. Supabase Credentials (For Inquiries / Contact Form)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# Replace with your actual project URL and anon public key:
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# -----------------------------------------------------------------------------
# 3. AI Assistant (Grok AI / xAI or OpenAI)
# Add your Grok API key (from https://console.x.ai) to enable Grok 2 reasoning!
# If left blank, the assistant runs on the built-in portfolio knowledge base.
# -----------------------------------------------------------------------------
GROK_API_KEY=""
# XAI_API_KEY=""
# OPENAI_API_KEY=""

