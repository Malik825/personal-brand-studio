SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key-here"

# -----------------------------------------------------------------------------
# 3. OpenAI API Key (For Live Assistant Chatbot)
# Add your key to enable live GPT-4o-mini generation in "Ask Sule's Assistant".
# If left blank, the assistant runs seamlessly on the built-in portfolio knowledge base!
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
