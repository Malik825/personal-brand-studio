# =============================================================================
# Sule Malik Personal Brand Studio — Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Sanity.io CMS
# -----------------------------------------------------------------------------
VITE_SANITY_PROJECT_ID="wcfopvjq"
VITE_SANITY_DATASET="production"
VITE_SANITY_API_VERSION="2024-01-01"

# -----------------------------------------------------------------------------
# 2. Supabase Database & Inquiries
# Replace these with your project credentials from:
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-server-operations"

# -----------------------------------------------------------------------------
# 3. AI Chatbot (Grok AI / xAI or OpenAI)
# Add your Grok API key from https://console.x.ai or OpenAI API key.
# If omitted, the assistant seamlessly runs on the built-in portfolio knowledge base.
# -----------------------------------------------------------------------------
GROK_API_KEY=""
# XAI_API_KEY=""
# OPENAI_API_KEY=""
